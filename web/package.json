{
  "name": "machina-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright": "node scripts/run-playwright.mjs",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:install": "node scripts/run-playwright.mjs install --with-deps chromium",
    "test:e2e:live-ux": "node scripts/run-playwright.mjs -c playwright.live-ux.config.ts",
    "test:e2e:features": "node scripts/run-playwright.mjs -c playwright.feature-matrix.config.ts",
    "test:e2e:features:live": "node scripts/run-playwright.mjs -c playwright.feature-matrix.live.config.ts",
    "test:e2e:ui": "node scripts/run-playwright.mjs --ui",
    "check-ui-tokens": "node scripts/check-ui-tokens.mjs",
    "generate-openapi": "node ../scripts/generate-openapi.mjs",
    "generate-openapi:check": "node ../scripts/generate-openapi.mjs --check",
    "api-ux-coverage": "node ../scripts/api-ux-coverage.mjs --write",
    "api-ux-coverage:check": "node ../scripts/api-ux-coverage.mjs --check",
    "generate-ux-live-manifest": "node ../scripts/generate-ux-live-manifest.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^12.40.0",
    "i18next": "^25.2.1",
    "lucide-react": "^0.475.0",
    "novnc-core": "^0.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.2",
    "react-router": "^7.5.0",
    "recharts": "^2.15.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/three": "^0.170.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  },
  "license": "SEE LICENSE IN LICENSE"
}
