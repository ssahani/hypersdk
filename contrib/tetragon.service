[Unit]
Description=Cilium Tetragon eBPF sensor (Machina Zeus)
Documentation=https://github.com/cilium/tetragon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tetragon --config-dir /var/lib/machina/tetragon/config --tracing-policy-dir /var/lib/machina/tetragon/tracing-policies
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tetragon

[Install]
WantedBy=multi-user.target
