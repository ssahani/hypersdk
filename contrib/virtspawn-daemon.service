[Unit]
Description=virtspawn libvirt management daemon
Documentation=https://github.com/ssahani/-virtspawn
After=libvirtd.service network-online.target
Requires=libvirtd.service
Wants=network-online.target

[Service]
# Match hyper2kvm h2kweb-style layout: runtime/state/log dirs, journal, resource caps.
# Use `Type=notify` + `WatchdogSec=` when you want watchdog pings (daemon sends READY=1
# after bind and WATCHDOG=1 from WATCHDOG_USEC).
Type=simple
# Type=notify
# WatchdogSec=2min

User=root
Group=root

EnvironmentFile=-/etc/default/virtspawn-daemon
Environment=RUST_LOG=info
# install.sh installs mkosi to /usr/local/bin/mkosi; some distros' default root PATH omits it.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# ProtectHome=read-only blocks /root/.cache; redirect virt-builder and pip caches to writable dirs.
Environment=XDG_CACHE_HOME=/var/cache/virtspawn

ExecStart=/usr/local/bin/virtspawn-daemon --config /etc/virtspawn/config.toml
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

RuntimeDirectory=virtspawn
StateDirectory=virtspawn
LogsDirectory=virtspawn

StandardOutput=journal
StandardError=journal
SyslogIdentifier=virtspawn-daemon

MemoryMax=2G
TasksMax=256

# Filesystem protection — relaxed for host networking management
# (ip, iptables, nmcli need access to /sys, /proc, /run)
ProtectHome=read-only
# PrivateTmp breaks libguestfs (virt-builder): qemu (uid:107) can't access /tmp/libguestfsXXX/ in the private namespace.
# PrivateTmp=true

# Network access
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
