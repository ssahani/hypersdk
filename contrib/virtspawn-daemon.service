[Unit]
Description=virtspawn libvirt management daemon
Documentation=https://github.com/ssahani/-virtspawn
After=libvirtd.service network-online.target
Requires=libvirtd.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/virtspawn-daemon --config /etc/virtspawn/config.toml
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info

# Filesystem protection
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/libvirt /dev/pts
PrivateTmp=true

# Privilege restrictions
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Network: only needed for daemon bind + libvirt socket
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# System call filter
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
