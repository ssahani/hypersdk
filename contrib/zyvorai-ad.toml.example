# Machina daemon — Active Directory login for zyvorai.local
# Copy relevant [auth.ldap] block into /etc/machina/config.toml
# Domain: zyvorai.local · DC: 45.82.66.172
# Test: sshant@zyvorai.local or short name sshant (with UPN suffix in login form)
#
# LAB-ONLY EXAMPLE — this uses a plaintext "ldap://" URI with use_tls = false,
# so every bind (including the service account bind_password, or the user's
# own AD password on direct UPN bind) goes over the wire unencrypted. That is
# acceptable only on an isolated/trusted lab network. For any production or
# network-reachable deployment, use "ldaps://<dc>:636" (implicit TLS) or set
# use_tls = true (STARTTLS on port 389) — see docs/ldap-auth.md, which shows
# the production-shaped example (ldaps://dc.example.com:636).

[auth.ldap]
enabled = true
url = "ldap://45.82.66.172:389"
base_dn = "DC=zyvorai,DC=local"
user_filter = "(sAMAccountName={username})"
# Optional service account for search-before-bind (leave empty when users sign in with UPN):
# bind_dn = "CN=svc-machina,CN=Users,DC=zyvorai,DC=local"
# bind_password = "CHANGE_ME_NOT_A_REAL_PASSWORD"
# Or direct UPN template when users always type user@domain:
# user_dn_template = "{username}"
member_attribute = "memberOf"
# use_tls / insecure_tls below are false only because this lab DC is reached
# over a trusted point-to-point link. Set use_tls = true (or use ldaps:// above)
# before pointing this at any DC outside an isolated lab.
use_tls = false
insecure_tls = false
