{
  "openapi": "3.0.3",
  "info": {
    "title": "PacketWolf Zeus Security Fabric API",
    "version": "0.1.0",
    "description": "eBPF security fabric consumed by Machina Zeus OS control plane"
  },
  "paths": {
    "/health": { "get": { "summary": "Health probe" } },
    "/api/v1/hosts/{host_id}/summary": { "get": { "summary": "Host threat score and sensor status" } },
    "/api/v1/hosts/{host_id}/processes": { "get": { "summary": "Process exec events" } },
    "/api/v1/hosts/{host_id}/connections": { "get": { "summary": "Network connect events" } },
    "/api/v1/hosts/{host_id}/dns": { "get": { "summary": "DNS query events" } },
    "/api/v1/hosts/{host_id}/files": { "get": { "summary": "Sensitive file change events" } },
    "/api/v1/hosts/{host_id}/ports": { "get": { "summary": "Open ports with process metadata" } },
    "/api/v1/hosts/{host_id}/timeline": { "get": { "summary": "Unified security timeline" } },
    "/api/v1/hosts/{host_id}/process-graph": { "get": { "summary": "Process ancestry graph" } },
    "/api/v1/flows": { "get": { "summary": "Network flows" } },
    "/api/v1/flows/stats": { "get": { "summary": "Flow statistics" } },
    "/api/v1/anomalies": { "get": { "summary": "Threat anomalies" } },
    "/api/v1/search": { "post": { "summary": "Event search" } },
    "/api/v1/fleet/threat-summary": { "get": { "summary": "Fleet threat rollup" } },
    "/api/v1/sensors": { "get": { "summary": "Tetragon sensor inventory" } },
    "/api/v1/ingest/{host_id}": { "post": { "summary": "Ingest Tetragon JSON batch" } },
    "/api/v1/asset-inventory": { "get": { "summary": "Topology asset inventory from flows" } }
  },
  "components": {
    "schemas": {
      "SecurityEvent": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "host_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "kind": { "enum": ["process_exec", "network_connect", "dns_query", "file_write", "privilege_esc", "security"] },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "process": { "type": "object" },
          "network": { "type": "object" },
          "dns": { "type": "object" },
          "file": { "type": "object" },
          "k8s": { "type": "object" },
          "verdict": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
