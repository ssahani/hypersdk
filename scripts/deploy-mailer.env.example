# SMTP for Machina deploy / E2E report emails.
# Never commit real passwords — use a Zoho *App Password*.
# Copy to deploy-mailer.env locally, or reuse ../hypersdk-web/contact-mailer.env.

SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USERNAME=info@zyvor.dev
SMTP_PASSWORD=your_zoho_app_password_here
SMTP_FROM=info@zyvor.dev
SMTP_USE_TLS=true

# Comma-separated recipients for deploy reports
DEPLOY_REPORT_TO=ssahani@zyvor.dev,sibu@zyvor.dev
DEPLOY_REPORT_SUBJECT_PREFIX=[Machina Deploy]
