{
  "name": "machina-regression",
  "private": true,
  "version": "0.1.0",
  "description": "Live-host CDP + API regression sweeps for Machina",
  "type": "commonjs",
  "scripts": {
    "install-deps": "npm install",
    "pages": "node page-sweep.js",
    "api": "node api-sweep.js",
    "ops": "node ops-interactive.js",
    "lifecycle": "node ops-lifecycle.js",
    "platform": "node ops-platform.js",
    "infra": "node ops-infra.js",
    "fleet": "node ops-fleet.js",
    "mission": "node ops-mission.js",
    "catalog": "node ops-catalog.js",
    "hardware": "node ops-hardware.js",
    "host": "node ops-host.js",
    "storage": "node ops-storage.js",
    "zeus": "node ops-zeus.js",
    "audit": "node ops-audit.js",
    "volume": "node ops-volume.js",
    "disk": "node ops-disk.js",
    "power": "node ops-power.js",
    "net": "node ops-net.js",
    "guest": "node ops-guest.js",
    "ui": "node ui-interactive.js",
    "ui-settings": "node ui-settings.js",
    "ui-wizards": "node ui-wizards.js",
    "ui-security": "node ui-security.js",
    "ui-k8s-os": "node ui-k8s-os.js",
    "ui-mission": "node ui-mission.js",
    "ui-catalog": "node ui-catalog.js",
    "ui-hardware": "node ui-hardware.js",
    "ui-host": "node ui-host.js",
    "ui-storage": "node ui-storage.js",
    "ui-zeus": "node ui-zeus.js",
    "ui-audit": "node ui-audit.js",
    "ui-volume": "node ui-volume.js",
    "ui-power": "node ui-power.js",
    "ui-net": "node ui-net.js",
    "ui-guest": "node ui-guest.js",
    "once": "node api-sweep.js --loops 1 && node ops-interactive.js && node ops-lifecycle.js && node ops-platform.js && node ops-infra.js && node ops-fleet.js && node ops-mission.js && node ops-catalog.js && node ops-hardware.js && node ops-host.js && node ops-storage.js && node ops-zeus.js && node ops-audit.js && node ops-volume.js && node ops-disk.js && node ops-power.js && node ops-net.js && node ops-guest.js && node page-sweep.js --loops 1",
    "continuous": "node page-sweep.js --loops 0"
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
