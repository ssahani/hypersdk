{
  "name": "machina-regression",
  "private": true,
  "version": "0.1.0",
  "description": "Live-host CDP + API regression sweeps for Machina",
  "type": "commonjs",
  "scripts": {
    "install-deps": "npm install",
    "pages": "node page-sweep.js",
    "api": "node api-sweep.js",
    "ops": "node ops-interactive.js",
    "lifecycle": "node ops-lifecycle.js",
    "platform": "node ops-platform.js",
    "infra": "node ops-infra.js",
    "fleet": "node ops-fleet.js",
    "ui": "node ui-interactive.js",
    "ui-settings": "node ui-settings.js",
    "ui-wizards": "node ui-wizards.js",
    "ui-security": "node ui-security.js",
    "ui-k8s-os": "node ui-k8s-os.js",
    "once": "node api-sweep.js --loops 1 && node ops-interactive.js && node ops-lifecycle.js && node ops-platform.js && node ops-infra.js && node ops-fleet.js && node page-sweep.js --loops 1",
    "continuous": "node page-sweep.js --loops 0"
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
